generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String
  city        String   @default("Medellín")
  createdAt   DateTime @default(now())

  @@map("activities")
}
