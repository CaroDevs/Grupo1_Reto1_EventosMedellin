DATABASE_URL="postgresql://medellin:medellin@localhost:5432/medellin_activities?schema=public"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Cambia este valor por uno propio en tu .env local (no lo commitees distinto a este placeholder).
# Generarlo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-in-your-local-env"
JWT_EXPIRES_IN="1d"

# Client ID de OAuth 2.0 en Google Cloud Console (no es secreto, es el
# mismo valor que VITE_GOOGLE_CLIENT_ID en apps/web/.env).
GOOGLE_CLIENT_ID="change-me.apps.googleusercontent.com"
